{
  "expo": {
    "name": "Déclic",
    "slug": "declic",
    "version": "0.1.0",
    "scheme": "declic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.declic.app",
      "infoPlist": {}
    },
    "android": {
      "package": "org.declic.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Déclic accède à vos photos pour les ajouter à votre carnet de bord. Elles restent sur votre téléphone.",
          "cameraPermission": "Déclic utilise l'appareil photo pour valider vos défis. Les photos restent sur votre téléphone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F4F4F2",
          "dark": {
            "backgroundColor": "#0A0C10"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4aab0cfb-792a-460f-8059-4d09f2dcd6f6"
      }
    }
  }
}
